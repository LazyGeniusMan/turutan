version = "5.0"
name = "{{.project_name}}"
gitignore = true
compact = true

presets = [{{ range $i, $p := .enabled_ai_agents }}{{ if $i }}, {{ end }}"{{ $p }}"{{ end }}]

agents_md = true

[profiles]
core = ["core"]
custom = ["custom"]
ai = [
  "ai",
  "builtin:agent-delegation",
  "builtin:ai-governance",
  "builtin:cicd",
  "builtin:code-quality",
  "builtin:default-commands",
  "builtin:docker",
  "builtin:documentation",
  "builtin:git-workflow",
  "builtin:observability",
  "builtin:security",
  "builtin:testing",
  "builtin:token-efficiency",
]
c = ["c"]
cpp = ["cpp"]
csharp = ["csharp", "builtin:csharp"]
cloudflare = ["cloudflare"]
docker = ["docker", "yml"]
elixir = ["elixir", "builtin:elixir"]
github = ["github"]
gitlab = ["gitlab"]
go = [
  "go",
  "builtin:go",
]
java = ["java", "builtin:java"]
kubernetes = ["kubernetes", "yml"]
php = ["php", "builtin:php"]
python = ["python", "builtin:python"]
r = ["r", "builtin:r"]
ruby = ["ruby", "builtin:ruby"]
rust = ["rust", "builtin:rust", "builtin:polyglot-bindings"]
rust-polygot = [
  "rust-polygot",
  "builtin:cgo",
  "builtin:ext-php-rs",
  "builtin:extendr",
  "builtin:jni-rs",
  "builtin:magnus",
  "builtin:napi-rs",
  "builtin:pyo3",
  "builtin:rustler",
  "builtin:wasm",
]
typescript = [
  "typescript",
  "builtin:typescript",
  "builtin:vite-plus",
]
typst = ["typst"]

[header]
style = "detailed"
text = """
AI-RULEZ :: GENERATED FILE — DO NOT EDIT DIRECTLY
Source: .config/ai-rulez/config.toml

WHAT IS AI-RULEZ
AI-Rulez is a directory-based AI governance tool. All configuration lives in
the .config/ai-rulez/ directory. This file is auto-generated from source files.

.AI-RULEZ FOLDER ORGANIZATION
Root content (always included):
  .config/ai-rulez/config.toml                               Main configuration (presets, profiles)
  .config/ai-rulez/rules/                                    Mandatory rules for AI assistants
  .config/ai-rulez/context/                                  Reference documentation
  .config/ai-rulez/skills/                                   Specialized AI prompts
  .config/ai-rulez/agents/                                   Agent definitions
  .config/ai-rulez/domains/{name}/{rules,context,skills}/    Domain-specific

Profiles in config.toml control which domains are included.

INSTRUCTIONS FOR AI AGENTS
1. NEVER edit this file - it is auto-generated
2. ALWAYS edit files in .config/ai-rulez/ instead:
3. PREFER using the MCP Server, it provides safe CRUD tools for reading and modifying .config/ai-rulez/ content
4. After making changes: mise run dev-setup:ai-rulez

Documentation: https://github.com/Goldziher/ai-rulez
"""
hashes = "content"
timestamp = false

[defaults]
omit_agent_fields = ["model", "effort", "tools"]

[lock]
# ~keep enforce = true

[lint]
# ~keep security.allowed_hosts = ["github.com", "owasp.org", "api.cloudflare.com", "developers.cloudflare.com", "go.dev", "pkg.go.dev", "pptr.dev", "flueframework.com", "ryl-docs.pages.dev", "pitchfork.jdx.dev", "hk.jdx.dev"]

[rules]
mode = "split"

[[installed_skills]]
name = "ai-rulez"
source = "https://github.com/Goldziher/ai-rulez"
trust = "warn"
include = ["ai-rulez"]
domain = "ai"

[[installed_skills]]
name = "fnox"
source = "https://github.com/jdx/fnox"
trust = "warn"
include = ["fnox"]
domain = "core"

[[installed_skills]]
name = "hk"
source = "https://github.com/jdx/hk"
trust = "warn"
include = ["hk-*"]
domain = "core"

[[installed_skills]]
name = "pitchfork"
source = "https://github.com/jdx/pitchfork"
trust = "warn"
include = ["pitchfork"]
domain = "core"

[[installed_skills]]
name = "basemind"
source = "https://github.com/Goldziher/basemind"
trust = "warn"
include = ["basemind*", "multi-agent-room"]
domain = "ai"

[[installed_skills]]
name = "cloudflare"
source = "https://github.com/cloudflare/skills"
trust = "warn"
include = ["cloudflare", "workers-best-practices"]
domain = "cloudflare"

[[installed_skills]]
name = "docker"
source = "https://github.com/docker/skills"
trust = "warn"
include = ["docker-*"]
domain = "docker"

[[installed_skills]]
name = "ryl"
source = "https://github.com/owenlamont/ryl"
trust = "warn"
include = ["*"]
domain = "yml"

[[installed_skills]]
name = "github"
source = "https://github.com/github/awesome-copilot"
trust = "warn"
include = ["github-*"]
domain = "github"

[[installed_skills]]
name = "gitlab"
source = "https://gitlab.com/gitlab-org/ai/skills"
trust = "warn"
include = ["glab"]
domain = "github"

[[installed_skills]]
name = "golang"
source = "https://github.com/samber/cc-skills-golang"
trust = "warn"
include = ["golang-*"]
domain = "go"

[mcp]
self_server = false

[[mcp_servers]]
name = "ai-rulez-crud"
command = "ai-rulez"
args = ["mcp"]
domain = "ai"

[[mcp_servers]]
name = "ai-rulez-skill-registry"
command = "ai-rulez"
args = ["mcp", "--serve-skills"]
env = { AI_RULEZ_PROFILE = "${AI_RULEZ_PROFILE}" }
domain = "ai"

[[mcp_servers]]
name = "fnox"
command = "fnox"
args = ["mcp"]
domain = "core"

[[mcp_servers]]
name = "mise"
env = { MISE_EXPERIMENTAL = "1" }
command = "mise"
args = ["mcp", "--cd", "${PROJECT_ROOT}"]
domain = "core"

[[mcp_servers]]
name = "hk"
command = "hk"
args = ["mcp", "--root", "${PROJECT_ROOT}"]
domain = "core"

[[mcp_servers]]
name = "basemind"
command = "basemind"
args = ["serve"]
domain = "ai"

[[mcp_servers]]
name = "keenable"
transport = "http"
url = "https://api.keenable.ai/mcp"
headers = { "X-API-Key" = "${KEENABLE_API_KEY}" }
domain = "custom"

[[mcp_servers]]
name = "cloudflare-docs"
transport = "http"
url = "https://docs.mcp.cloudflare.com/mcp"
domain = "cloudflare"
