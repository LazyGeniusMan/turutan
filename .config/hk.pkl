amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local pre_commit = new Mapping<String, Step> {
  ["newlines"] = (Builtins.newlines) {
    profiles = List("core")
  }
  ["mixed-line-ending"] = (Builtins.mixed_line_ending) {
    profiles = List("core")
    depends = "newlines"
  }
  ["uncomment"] {
    profiles = List("ai")
    glob = List("**")
    check = "uncomment --check {{files}}"
    fix = "uncomment {{files}}"
    depends = "mixed-line-ending"
  }
  ["pkl-format"] = (Builtins.pkl_format) {
    profiles = List("core")
    depends = "uncomment"
  }

  ["pkl"] = (Builtins.pkl) {
    profiles = List("core")
    depends = "pkl-format"
  }
  ["tombi-format"] = (Builtins.tombi_format) {
    profiles = List("core")
    depends = "uncomment"
  }
  ["tombi"] = (Builtins.tombi) {
    profiles = List("core")
    depends = "tombi-format"
  }
  ["mise"] = (Builtins.mise) {
    profiles = List("core")
    depends = "tombi"
  }
  ["golangci-lint-fmt"] = (Builtins.golangci_lint_fmt) {
    profiles = List("go")
    depends = "uncomment"
  }
  ["golangci-lint"] = (Builtins.golangci_lint) {
    profiles = List("go")
    depends = "golangci-lint-fmt"
  }
  ["go-unit-test"] {
    profiles = List("go")
    batch = true
    check = "go test -short ./..."
    depends = "golangci-lint"
  }
  ["go-integration-test"] {
    profiles = List("go")
    batch = true
    check = "go test -tags=integration -count=1 ./internal/scaffold/"
    depends = "go-unit-test"
  }
  ["betterleaks"] = (Builtins.betterleaks) {
    profiles = List("core")
    depends = "uncomment"
  }
  ["detect-private-key"] = (Builtins.detect_private_key) {
    profiles = List("core")
    depends = "uncomment"
  }
  ["fnox-scan"] {
    profiles = List("core")
    check = "fnox scan"
    depends = "uncomment"
  }
  ["fnox-check"] {
    profiles = List("core")
    glob = ".config/fnox.toml"
    check = "fnox check"
    depends = "tombi"
  }
  ["ryl"] = (Builtins.ryl) {
    profiles = List("github")
    depends = "uncomment"
  }
  ["jactionlint"] {
    profiles = List("github")
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    batch = true
    check = "jactionlint {{files}}"
    diagnostic_format = "gcc"
    depends = "ryl"
  }
  ["updatecli-validate"] {
    profiles = List("github")
    glob = List(".config/updatecli/*.yaml", ".config/updatecli/*.yml")
    batch = true
    check = "updatecli manifest show --config .config/updatecli/"
    depends = "ryl"
  }
}

local pre_push = new Mapping<String, Step> {
  ["ai-rulez"] {
    profiles = List("ai")
    glob = ".config/ai-rulez/config.toml"
    check = "ai-rulez validate"
    depends = "tombi"
  }
  ["gomod-tidy"] = (Builtins.gomod_tidy) {
    profiles = List("go")
    depends = "uncomment"
  }
  ["go-vuln-check"] = (Builtins.go_vuln_check) {
    profiles = List("go")
    depends = "gomod-tidy"
  }
  ["go-sec"] = (Builtins.go_sec) {
    profiles = List("go")
    check = "gosec ./cmd/... ./internal/..."
    depends = "go-vuln-check"
  }
  ["go-build"] {
    profiles = List("go")
    batch = true
    check = "go build ./..."
    depends = "go-sec"
  }
  ["go-e2e"] {
    profiles = List("go")
    batch = true
    check = "go test -tags=integration -count=1 ./..."
    depends = "go-build"
  }
}

hooks {
  ["check"] {
    steps = pre_commit
  }
  ["fix"] {
    steps = pre_commit
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps = pre_commit
  }
  ["pre-push"] {
    steps = pre_push
  }
  ["post-checkout"] {
    steps {
      ["install-deps"] {
        step_condition = "is_branch_checkout"
        check = "mise install"
      }
    }
  }
}
