module hk.Github

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl" as Config

pre_commit: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
  ["ryl"] = (Builtins.ryl) {
    profiles = List("github")
    check = "ryl check {{files}}"
    depends = "uncomment"
  }
  ["jactionlint"] {
    profiles = List("github")
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    batch = true
    check = "jactionlint {{files}}"
    diagnostic_format = "gcc"
    depends = "ryl"
  }
}
