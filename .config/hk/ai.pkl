module hk.Ai

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl" as Config

pre_commit: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
  ["uncomment"] {
    profiles = List("ai")
    glob = List("**")
    check = "uncomment --check {{files}}"
    fix = "uncomment {{files}}"
    depends = "mixed-line-ending"
  }
}

pre_push: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
  ["ai-rulez"] {
    profiles = List("ai")
    glob = ".config/ai-rulez/**"
    check = "ai-rulez validate --config-only"
    depends = "no-commit-to-branch"
  }
}

pre_push_ci: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
  ["ai-rulez"] {
    profiles = List("ai")
    glob = ".config/ai-rulez/**"
    check = "ai-rulez validate --config-only"
  }
}
