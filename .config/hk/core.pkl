module hk.Core

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl" as Config

pre_commit: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
  ["newlines"] = (Builtins.newlines) {
    profiles = List("core")
  }
  ["mixed-line-ending"] = (Builtins.mixed_line_ending) {
    profiles = List("core")
    depends = "newlines"
  }
  ["pkl-format"] = (Builtins.pkl_format) {
    profiles = List("core")
    depends = "uncomment"
  }
  ["pkl"] = (Builtins.pkl) {
    profiles = List("core")
    depends = "pkl-format"
  }
  ["tombi-format"] = (Builtins.tombi_format) {
    profiles = List("core")
    depends = "uncomment"
  }
  ["tombi"] = (Builtins.tombi) {
    profiles = List("core")
    depends = "tombi-format"
  }
  ["mise"] = (Builtins.mise) {
    profiles = List("core")
    depends = "tombi"
  }
  ["betterleaks"] = (Builtins.betterleaks) {
    profiles = List("core")
    depends = "uncomment"
  }
  ["detect-private-key"] = (Builtins.detect_private_key) {
    profiles = List("core")
    depends = "uncomment"
  }
  ["fnox-scan"] {
    profiles = List("core")
    check = "fnox scan"
    depends = "uncomment"
  }
  ["fnox-check"] {
    profiles = List("core")
    glob = ".config/fnox.toml"
    check = "fnox check"
    depends = "tombi"
  }
  ["updatecli-validate"] {
    profiles = List("core")
    glob = List(".config/updatecli/*.yaml", ".config/updatecli/*.yml")
    batch = true
    check = "updatecli manifest show --config .config/updatecli/"
    depends = "ryl"
  }
}

pre_push: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
  ["no-commit-to-branch"] = (Builtins.no_commit_to_branch) {
    profiles = List("core")
  }
}
